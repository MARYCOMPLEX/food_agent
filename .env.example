# XHS Food Agent Environment Configuration
# 复制此文件为 .env 并填入实际值

# ===========================================
# XHS Spider Settings (Required)
# ===========================================
# 推荐：用 auth 模块自动登陆（无需手工复制 cookie）
#   python -m xhs_food.auth qr           # 扫码登陆
#   python -m xhs_food.auth login 13xxx  # 短信登陆
#   python -m xhs_food.auth profiles     # 查看登陆状态
# 登陆成功后写到 ./.xhs_profiles/default.json，spider 自动读取，下面 XHS_COOKIES 不用填
#
# 兜底（不推荐）：手工从浏览器复制 cookie 字符串
# XHS_COOKIES="abRequestId=...; a1=...; web_session=...; ..."

# ===========================================
# LLM API Settings (Required)
# ===========================================
# 已验证的 OpenAI-compatible provider（密钥只写入本地 .env）

# TokenRhythm
OPENAI_API_KEY="your_api_key_here"
OPENAI_API_BASE="https://tokenrhythm.studio/v1"
DEFAULT_LLM_MODEL="deepseek-v4-flash-0731"

# OpenAI (可选)
# OPENAI_API_KEY="sk-xxx"
# OPENAI_API_BASE="https://api.openai.com/v1/"
# DEFAULT_LLM_MODEL="gpt-4o-mini"

# DeepSeek (可选)
# OPENAI_API_KEY="sk-xxx"
# OPENAI_API_BASE="https://api.deepseek.com/v1/"
# DEFAULT_LLM_MODEL="deepseek-chat"

# ===========================================
# Search Settings
# ===========================================
# 搜索模式: true=深度研究（无笔记上限），false=快速模式（有笔记上限）
SEARCH_DEEP_MODE=false

# 快速模式下的笔记搜索上限
SEARCH_NOTE_LIMIT=15

# 每次关键词搜索返回的笔记数
SEARCH_NOTES_PER_KEYWORD=4

# 最终推荐的店铺数量上限
SEARCH_MAX_RESTAURANTS=10

# 跨会话后台任务上限；单个 Plan 内还有 capability 级并发限制
SEARCH_TASK_CONCURRENCY=20

# Agent Loop 默认使用可复现的规则规划器；开启后使用 Agents SDK typed planner
AGENT_MODEL_PLANNER_ENABLED=false
AGENT_LOOP_MAX_ITERATIONS=8
AGENT_LOOP_MAX_REPLANS=3
AGENT_LOOP_TIMEOUT_SECONDS=180
AGENT_LOOP_MAX_STEPS=64
AGENT_CAPABILITY_CONCURRENCY=8

# SSE 流超时时间（秒），分析评论可能较慢，建议设大一些
SSE_TIMEOUT=900

# ===========================================
# Optional Settings
# ===========================================
# LOG_LEVEL=INFO
# API_HOST=0.0.0.0
# API_PORT=8000

# ===========================================
# Session Management (Optional)
# ===========================================
# Redis - Short-term context cache (uses in-memory fallback if not set)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DATABASE=0
# REDIS_PASSWORD=

# PostgreSQL - Long-term persistent history with vector search
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=xhs_food_agent
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=

# ===========================================
# Embedding API (Optional - for vector search)
# ===========================================
# Separate embedding API config (if different from LLM API)
# EMBEDDING_API_KEY="your_embedding_api_key"
# EMBEDDING_API_BASE="https://api.openai.com/v1/"
# EMBEDDING_MODEL="text-embedding-3-small"
