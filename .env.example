# XHS Food Agent Environment Configuration
# 复制此文件为 .env 并填入实际值

# ===========================================
# Legacy XHS compatibility settings (optional for modular connectors)
# ===========================================
# These variables are used only by the legacy xhs.compat path. When
# MODULAR_PLATFORM_CONNECTORS_ENABLED=true, use the account-scoped login
# control plane and an opaque CREDENTIAL_REF instead (see the section below).
# Legacy 推荐：用 auth 模块自动登陆（无需手工复制 cookie）
#   python -m xhs_food.auth qr           # 扫码登陆
#   python -m xhs_food.auth login 13xxx  # 短信登陆
#   python -m xhs_food.auth profiles     # 查看登陆状态
# 登陆成功后写到 ./.xhs_profiles/default.json，legacy spider 自动读取；
# 模块化账号 authority 不读取此 profile，下面的 XHS_COOKIES 也不用填
#
# 兜底（不推荐）：手工从浏览器复制 cookie 字符串
# XHS_COOKIES="abRequestId=...; a1=...; web_session=...; ..."

# ===========================================
# LLM API Settings (Required)
# ===========================================
# 默认支持 SiliconFlow (硅基流动)，也支持任何 OpenAI 兼容 API

# SiliconFlow (推荐 - 免费额度)
OPENAI_API_KEY="your_api_key_here"
OPENAI_API_BASE="https://api.siliconflow.cn/v1/"
DEFAULT_LLM_MODEL="Qwen/Qwen3-8B"

# OpenAI (可选)
# OPENAI_API_KEY="sk-xxx"
# OPENAI_API_BASE="https://api.openai.com/v1/"
# DEFAULT_LLM_MODEL="gpt-4o-mini"

# DeepSeek (可选)
# OPENAI_API_KEY="sk-xxx"
# OPENAI_API_BASE="https://api.deepseek.com/v1/"
# DEFAULT_LLM_MODEL="deepseek-chat"

# ===========================================
# Search Settings
# ===========================================
# 搜索模式: true=深度研究（无笔记上限），false=快速模式（有笔记上限）
SEARCH_DEEP_MODE=false

# 快速模式下的笔记搜索上限
SEARCH_NOTE_LIMIT=15

# 每次关键词搜索返回的笔记数
SEARCH_NOTES_PER_KEYWORD=4

# 最终推荐的店铺数量上限
SEARCH_MAX_RESTAURANTS=10

# SSE 流超时时间（秒），分析评论可能较慢，建议设大一些
SSE_TIMEOUT=900

# ===========================================
# Optional Settings
# ===========================================
# LOG_LEVEL=INFO
# API_HOST=0.0.0.0
# API_PORT=8000

# ===========================================
# Session Management (Optional)
# ===========================================
# Redis - Short-term context cache (uses in-memory fallback if not set)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DATABASE=0
# REDIS_PASSWORD=

# PostgreSQL - Long-term persistent history with vector search
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=xhs_food_agent
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=

# ===========================================
# Modular platform connectors (opt-in)
# ===========================================
# Integration branch: codex/integrate-platform-source-connectors
#
# The provider checkouts are external, pinned snapshots. Keep them outside
# this repository and point the Composition Root at the local checkout (or an
# approved sidecar); do not copy upstream .env files, cookies, SQLite files,
# or generated profiles into this project.
# Dianping source: https://github.com/MARYCOMPLEX/dazhongdianping.git
# XHS source:      https://github.com/cv-cat/Spider_XHS.git
# MODULAR_PLATFORM_CONNECTORS_ENABLED=false
# MODULAR_PLATFORM_DIANPING_ENABLED=false
# MODULAR_PLATFORM_XHS_ENABLED=false
# MODULAR_PLATFORM_LOGIN_ENABLED=false
# MODULAR_PLATFORM_DIANPING_CHECKOUT=CHECKOUT_PATH_DIANPING
# MODULAR_PLATFORM_XHS_CHECKOUT=CHECKOUT_PATH_XHS
# MODULAR_PLATFORM_PROVIDER_MODE=in_process
# MODULAR_PLATFORM_PROVENANCE_REF=PROVENANCE_REF
# MODULAR_PLATFORM_LICENSE_APPROVAL_REF=OWNER_LEGAL_REF
# MODULAR_PLATFORM_LEASE_TTL_SECONDS=180
# MODULAR_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DB
# MODULAR_TEMPORAL_ADDRESS=HOST:PORT
# MODULAR_TEMPORAL_NAMESPACE=default
# MODULAR_TEMPORAL_RESEARCH_QUEUE=research
# MODULAR_TEMPORAL_REFRESH_QUEUE=refresh
# MODULAR_TEMPORAL_MEDIA_QUEUE=media

# Account-auth is a separate, optional Temporal queue. Leave it disabled until
# its worker, vault/credential resolver, and ObjectStore have been qualified.
# MODULAR_TEMPORAL_ACCOUNT_AUTH_QUEUE=account-auth
# MODULAR_TEMPORAL_ACCOUNT_AUTH_ENABLED=false
# MODULAR_TEMPORAL_ACCOUNT_AUTH_MAX_CONCURRENT_ACTIVITIES=2
# MODULAR_TEMPORAL_ACCOUNT_AUTH_MAX_CONCURRENT_WORKFLOWS=2
# MODULAR_TEMPORAL_ACCOUNT_AUTH_PRIORITY=75

# ObjectStore owns QR/media bytes (MinIO locally, S3-compatible storage in
# production). PostgreSQL remains the account/session/schema authority and
# Redis remains rebuildable hot state only (SSE/status/idempotency/rate limit).
# MODULAR_OBJECT_STORE_ENVIRONMENT=local
# MODULAR_OBJECT_STORE_ENDPOINT_URL=http://localhost:9000
# MODULAR_OBJECT_STORE_BUCKET=food-agent
# MODULAR_OBJECT_STORE_REGION=us-east-1
# MODULAR_OBJECT_STORE_ACCESS_KEY=OBJECT_STORE_ACCESS_KEY
# MODULAR_OBJECT_STORE_SECRET_KEY=OBJECT_STORE_SECRET_KEY
# MODULAR_OBJECT_STORE_SERVER_SIDE_ENCRYPTION=test
# MODULAR_OBJECT_STORE_ENCRYPTION_KEY_REF=ENCRYPTION_KEY_REF  # only with aws:kms
# MODULAR_OBJECT_STORE_SIGNED_URL_TTL_SECONDS=300
# MODULAR_OBJECT_STORE_ORPHAN_GRACE_SECONDS=3600
# MODULAR_OBJECT_STORE_MAX_CONCURRENCY=4
# MODULAR_OBJECT_STORE_MAX_BYTES=52428800

# Each account is isolated by (tenant_id, platform channel, account_ref):
# dianping, xhs_pc, and xhs_creator never share cookies, signer/device state,
# leases, health, or encrypted session versions. Login APIs accept only an
# opaque vault handle (CREDENTIAL_REF); raw cookies and QR contents never go
# into API/Temporal/Redis history. XHS Creator publishing remains disabled.

# ===========================================
# Embedding API (Optional - for vector search)
# ===========================================
# Separate embedding API config (if different from LLM API)
# EMBEDDING_API_KEY="your_embedding_api_key"
# EMBEDDING_API_BASE="https://api.openai.com/v1/"
# EMBEDDING_MODEL="text-embedding-3-small"
