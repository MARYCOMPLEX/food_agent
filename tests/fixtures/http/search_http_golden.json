  "new_search_missing_query": {
    "request": {
      "method": "POST",
      "path": "/v1/search/",
      "json": {}
    },
    "response": {
      "status": 400,
      "json": {
        "detail": "新查询必须提供 query 参数"
      }
    }
  },
  "request_validation_error": {
    "request": {
      "method": "POST",
      "path": "/v1/search/",
      "json": {
        "query": [
          "不是字符串"
        ]
      }
    },
    "response": {
      "status": 422,
      "json": {
        "detail": [
          {
            "type": "string_type",
            "loc": [
              "body",
              "query"
            ],
            "msg": "Input should be a valid string",
            "input": [
              "不是字符串"
            ]
          }
        ]
      }
    }
  },
  "recover_not_found": {
