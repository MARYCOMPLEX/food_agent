      "json": {
        "query": "自贡本地人常吃什么？"
      }
    },
    "response": {
      "status": 200,
      "json": {
        "success": true,
        "data": {
          "sessionId": "fixed-session-id",
          "streamUrl": "/v1/search/stream/fixed-session-id",
          "action": "new_search"
        }
      }
    }
  },
  "refine": {
