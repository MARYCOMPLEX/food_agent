            "title": "Query"
          },
          "sessionId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "会话ID（复用现有会话时填写）",
            "title": "Sessionid"
          }
        },
        "title": "UnifiedSearchRequest",
        "type": "object"
      },
