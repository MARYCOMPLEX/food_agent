      "SSE_HEARTBEAT_SECONDS",
      "SSE_TIMEOUT_SECONDS",
      "XHS_COOKIES",
      "XHS_LOG_DB_PATH",
      "XHS_PROFILE_DIR"
    ],
    "defaults": {
      "openai_api_key": null,
      "openai_api_base": "https://api.siliconflow.cn/v1/",
      "default_llm_model": "Qwen/Qwen3-8B",
      "llm_temperature": 0.2,
      "llm_max_tokens": 1024,
      "embedding_api_key": null,
      "embedding_api_base": null,
      "embedding_model": "text-embedding-3-small",
      "search_deep_mode": false,
      "search_note_limit": 15,
      "search_notes_per_keyword": 4,
      "search_max_restaurants": 10,
      "analyze_concurrency": 5,
      "poi_concurrency": 5,
      "api_host": "0.0.0.0",
      "api_port": 8000,
      "sse_heartbeat_seconds": 30,
      "sse_timeout_seconds": 900,
      "cors_origins": [
        "http://localhost:5173"
      ],
      "rate_limit_search": "10/minute",
      "event_bus_backend": "memory",
      "event_stream_ttl_seconds": 3600,
      "event_stream_maxlen": 1000,
      "redis_url": null,
      "redis_host": null,
      "redis_port": 6379,
      "redis_database": 0,
      "redis_username": null,
      "redis_password": null,
      "database_url": null,
      "postgres_host": null,
      "postgres_port": 5432,
      "postgres_db": "xhs_food_agent",
      "postgres_user": "postgres",
      "postgres_password": null,
      "xhs_cookies": null,
      "xhs_profile_dir": null,
      "xhs_log_db_path": null,
      "log_level": "INFO"
    }
  },
