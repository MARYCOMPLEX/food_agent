    },
    {
      "schemaVersion": "memory-record/v1",
      "recordId": "mem-feedback-001",
      "tenantId": "tenant-cn-1",
      "subject": {"kind": "user", "id": "user-2b4aa1b95c884d64", "cohort": "returning", "locale": "zh-CN"},
      "sessionId": null,
      "layer": "strategy_feedback",
      "key": "research_depth",
      "value": {"dimension": "research_depth", "value": "deep"},
      "confidence": null,
      "sourceEventIds": ["feedback-009"],
