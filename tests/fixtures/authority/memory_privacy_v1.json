      "createdAt": "2026-08-18T10:00:00Z",
      "updatedAt": "2026-08-18T10:00:00Z"
    },
    {
      "schemaVersion": "memory-record/v1",
      "recordId": "mem-inferred-001",
      "tenantId": "tenant-cn-1",
      "subject": {"kind": "user", "id": "user-2b4aa1b95c884d64", "cohort": "returning", "locale": "zh-CN"},
      "sessionId": null,
      "layer": "inferred",
      "key": "style.local_longstanding",
      "value": {"kind": "affinity", "value": true, "supportEventIds": ["favorite-001", "click-008"]},
