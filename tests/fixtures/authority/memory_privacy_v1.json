      "validFrom": "2026-08-10T00:00:00Z",
      "expiresAt": "2026-11-08T00:00:00Z",
      "status": "active",
      "supersedesRecordId": null,
      "policyVersion": "memory-policy/v1",
      "createdAt": "2026-08-10T00:00:00Z",
      "updatedAt": "2026-08-10T00:00:00Z"
    }
  ],
  "claimFixture": {
    "claimId": "claim-001",
    "tenantId": "tenant-cn-1",
    "anonymousSubjectId": "anon-8bf1c0f4317f4e9d",
    "sessionId": "sess-anon-001",
    "oneTimeToken": "token-redacted-fixture",
    "targetUserId": "user-2b4aa1b95c884d64",
    "consentPolicyVersion": "memory-policy/v1",
    "idempotencyKey": "claim-idempotency-001"
  },
  "lifecycleFixtures": {
    "correction": {"newRecordId": "mem-explicit-002", "supersedesRecordId": "mem-explicit-001", "newValue": "no_spice", "oldStatus": "superseded"},
    "export": {"recordCount": 4, "format": "utf8-json", "includesPolicyVersion": true, "includesConsent": true, "includesRawEmbedding": false},
    "delete": {"target": "subject", "onlineStatus": "tombstoned", "redisInvalidated": true, "indexRebuildExcludes": "tombstoned"}
  }
}
