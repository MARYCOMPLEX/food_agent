    "finalOutputSchemaDigest": "2b5334db461f1c7b6dc831f94a4fc85bb228c471a14f83f3038d4fd2de1fb2c7",
    "finalOutputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "urn:food-agent:food:agent-final-output:v1",
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "summary", "recommendations"],
      "properties": {
        "schemaVersion": {"const": "food-agent-final-output/v1"},
        "summary": {"type": "string"},
        "recommendations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["entityId", "publicScore", "explanationRefs"],
            "properties": {
              "entityId": {"type": "string", "minLength": 1},
              "publicScore": {"type": "number", "minimum": 0, "maximum": 1},
              "explanationRefs": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "finalOutputExample": {
      "schemaVersion": "food-agent-final-output/v1",
      "summary": "找到 1 个公共候选。",
      "recommendations": [
        {"entityId": "restaurant-001", "publicScore": 0.91, "explanationRefs": ["evidence-001"]}
      ]
    },
    "scoringPolicy": {
      "policyId": "food.public-score",
      "policyVersion": "1.0.0",
      "mode": "pure_deterministic",
      "inputs": ["declared_public_feature_set", "explicit_versioned_config"],
      "forbiddenInputs": ["user_memory", "session_memory", "wall_clock", "randomness", "environment", "framework_state"],
      "forbiddenEffects": ["network", "filesystem", "database", "cache", "workflow", "connector"]
    },
    "domainSources": [
      {"capability": "place.lookup", "versionRange": ">=1.0.0,<2.0.0", "required": true},
      {"capability": "reviews.search", "versionRange": ">=1.0.0,<2.0.0", "required": true}
    ],
    "policyProfiles": {
      "workflow": "research-standard/v1",
      "freshness": "food-freshness/v1",
      "coverage": "food-coverage/v1",
      "stopping": "food-stopping/v1",
      "refreshJob": "food-refresh-declaration/v1"
    }
  },
  "registrationCases": [
    {"case": "complete_pack", "mutation": "none", "accepted": true, "failureCode": null},
    {"case": "missing_tool_output_schema", "mutation": "delete:allowedTools[0].outputSchema", "accepted": false, "failureCode": "invalid_tool_contract"},
    {"case": "invalid_final_output", "mutation": "finalOutputExample.recommendations[0].publicScore=2", "accepted": false, "failureCode": "invalid_final_output_schema"},
    {"case": "connector_embedded_in_pack", "mutation": "domainSources[0].connectorClass=ConcretePoiConnector", "accepted": false, "failureCode": "invalid_manifest"},
    {"case": "impure_score", "mutation": "scoringPolicy.forbiddenEffects-=network", "accepted": false, "failureCode": "impure_scoring_policy"},
    {"case": "required_source_missing", "mutation": "sourceGateway.unregister(place.lookup)", "accepted": false, "failureCode": "unresolved_source_capability"}
  ]
}
