{
  "authorityVersion": "domain-contract-authority/v1",
  "contractApi": "domain-contract/v1",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "discovery": {
    "entryPointGroup": "food_agent.domain_packs",
    "loadedBy": "composition_root",
    "loadTime": "worker_startup",
    "deploymentAllowListRequired": true,
    "requestSelectedImports": false,
    "networkDiscovery": false,
    "directoryScanning": false
  },
  "requiredMethods": [
    {
      "name": "describe",
      "inputSchemaId": "urn:food-agent:domain-method:describe-input:v1",
      "outputSchemaId": "urn:food-agent:domain-pack-manifest:v1",
      "pure": true
    },
    {
      "name": "classify_constraints",
      "inputSchemaId": "urn:food-agent:domain-method:classify-constraints-input:v1",
      "outputSchemaId": "urn:food-agent:domain-method:classify-constraints-output:v1",
      "pure": true
    },
    {
      "name": "validate_evidence",
      "inputSchemaId": "urn:food-agent:domain-method:validate-evidence-input:v1",
      "outputSchemaId": "urn:food-agent:domain-method:validate-evidence-output:v1",
      "pure": true
    },
    {
      "name": "compute_features",
      "inputSchemaId": "urn:food-agent:domain-method:compute-features-input:v1",
      "outputSchemaId": "urn:food-agent:domain-method:compute-features-output:v1",
      "pure": true
    },
    {
      "name": "score_public",
      "inputSchemaId": "urn:food-agent:domain-method:score-public-input:v1",
      "outputSchemaId": "urn:food-agent:domain-method:score-public-output:v1",
      "pure": true
    },
    {
      "name": "build_final_output",
      "inputSchemaId": "urn:food-agent:domain-method:build-final-output-input:v1",
      "outputSchemaId": "urn:food-agent:domain-method:build-final-output-output:v1",
      "pure": true
    },
    {
      "name": "map_error",
      "inputSchemaId": "urn:food-agent:domain-method:map-error-input:v1",
      "outputSchemaId": "urn:food-agent:stable-error:v1",
      "pure": true
    }
  ],
  "versioning": {
    "packVersionFormat": "semver",
    "contractCompatibility": "major",
    "selectionTime": "task_admission_only",
    "selectionPolicy": "highest_deployment_approved_compatible",
    "inFlightRenegotiation": false,
    "rollbackAffects": "new_tasks_only",
    "pinnedFields": [
      "domainId",
      "packVersion",
      "manifestDigest",
      "contractApi",
      "methodSchemaIdsAndDigests",
      "toolVersionsAndSchemaIdsAndDigests",
      "finalOutputSchemaIdAndDigest",
      "scoringPolicyVersion",
      "policyProfiles"
    ],
    "missingPinFailure": "pinned_contract_unavailable"
  },
  "effectiveToolSet": [
    "domain_pack_allow_list",
    "request_subject_authorization",
    "personalization_selected_subset"
  ],
  "extensionPoints": {
    "domainPack": "public_registered",
    "agentTool": "public_via_tool_gateway",
    "sourceConnector": "public_via_source_gateway",
    "mediaProcessor": "public_registered_separate_contract",
    "evidenceExtractor": "public_registered_separate_contract",
    "refreshJob": "public_policy_declaration_only",
    "fixedWorkflow": "not_public_select_approved_profile_only",
    "refreshCoordinator": "not_public_single_shared_owner",
    "scoringPolicy": "controlled_pure_deterministic_extension",
    "domainSources": "capability_declarations_only"
  },
  "registration": {
    "atomic": true,
    "partialActivation": false,
    "validationOrder": [
      "manifest_and_digest",
      "contract_and_core_compatibility",
      "required_method_set",
      "bundled_schema_ids_digests_and_examples",
      "per_tool_input_output_permission_timeout_and_errors",
      "final_output_schema_and_example",
      "scoring_purity_and_public_inputs",
      "required_source_capability_resolution",
      "atomic_registry_snapshot_publish"
    ],
    "failureCodes": [
      "invalid_manifest",
      "duplicate_pack_version",
      "incompatible_contract_api",
      "missing_contract_method",
      "invalid_schema_bundle",
      "invalid_tool_contract",
      "invalid_final_output_schema",
      "impure_scoring_policy",
      "unresolved_source_capability"
    ]
  },
  "manifestFixture": {
