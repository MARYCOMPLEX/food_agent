{
  "fixtureVersion": "b0-reliable-task-semantics/v1",
  "status": "normative-contract-fixture",
  "policyVersions": {
    "legacy": "legacy-task/v1",
    "reliable": "reliable-task/v1",
    "workflow": "research-task/v1",
    "activity": "research-activity/v1",
    "sse": "v1"
  },
  "identity": {
    "explicitKeyPath": "public_inputs.idempotency_key",
    "derivedFields": [
      "operation",
      "domain",
      "query",
      "target_task_id",
      "query_family_id",
      "session_ref",
      "tenant_ref",
      "compatibility_version"
    ],
    "anonymousFallback": "request_id",
    "taskIdPattern": "task-<sha256-prefix>",
    "workflowIdPattern": "research:<task_id>",
    "workflowIdAuthority": "temporal"
  },
  "authorities": {
    "semanticStateOwner": "research_coordinator",
    "executionCheckpoint": "temporal_history",
    "businessFacts": "postgresql",
    "businessProgressProjection": "postgresql_task_progress_projection",
    "hotEventProjection": "redis_stream_rebuildable",
    "binaryAssets": "s3_compatible_object_store"
  },
  "terminal": {
    "statuses": ["completed", "failed", "cancelled"],
    "exactlyOnePer": ["task_id", "turn_id"],
    "successRequires": "postgresql_result_commit_receipt",
    "publicationOrder": [
      "execute_activities",
      "postgresql_commit",
      "coordinator_terminal_projection",
      "event_projection"
    ],
    "resultIsTerminal": false,
    "oldRunMayOverwriteCurrent": false
  },
  "workflow": {
    "taskQueue": "research",
    "refreshTaskQueueReserved": "refresh",
    "mediaTaskQueueReserved": "media",
    "activityTimeoutSeconds": 300,
    "heartbeatTimeoutSeconds": 30,
    "retry": {
      "initialIntervalSeconds": 1,
      "maximumIntervalSeconds": 30,
      "backoffCoefficient": 2.0,
      "maximumAttempts": 3,
      "nonRetryableTypes": [
        "ValidationError",
        "PolicyDeniedError",
        "NonRetryableApplicationError",
        "ResultCommitRejected"
      ]
    }
  },
  "redisReplay": {
    "cursorHeader": "Last-Event-ID",
    "retainedCursorIsExclusive": true,
    "streamTtlSeconds": 3600,
    "streamMaxlen": 1000,
    "expiredEvent": "replay_expired",
    "expiredAction": "resync",
    "snapshotAuthority": "postgresql_task_progress_projection",
    "createsNewTask": false
  },
  "scenarios": [
    {
      "id": "duplicate-start",
      "given": "same stable task identity is submitted twice",
      "expect": [
        "one Temporal Workflow ID",
        "one task identity",
        "existing run is returned",
        "no Redis lock or second research execution"
      ]
    },
    {
      "id": "commit-before-terminal",
      "given": "result authority commit fails",
      "expect": [
        "no successful terminal event",
        "Workflow follows retry or stable failure policy"
      ]
    },
    {
      "id": "worker-crash-after-commit",
      "given": "PostgreSQL receipt exists but event publication is absent",
      "expect": [
        "reconciliation reuses the receipt",
        "terminal event is republished with the same event ID",
        "no duplicate result"
      ]
    },
    {
      "id": "late-old-run",
      "given": "an older run sends progress after a newer run is attached",
      "expect": [
        "older progress is ignored",
        "newer projection remains monotonic"
      ]
    },
    {
      "id": "refine-identity-boundary",
      "given": "a refine request changes query text or target identity",
      "expect": [
        "do not claim the derived hash is the same task/turn",
        "remain on legacy refine semantics until an explicit contract is approved"
      ]
    },
    {
      "id": "cancel-race",
      "given": "cancel and completion race",
      "expect": [
        "authority CAS/idempotency chooses one terminal status",
        "request-time cancellation does not fabricate a terminal"
      ]
    },
    {
      "id": "expired-replay",
      "given": "Last-Event-ID is trimmed, expired, unknown, or lost after Redis recovery",
      "expect": [
        "one replay_expired/resync control event",
        "authoritative task snapshot or terminal is returned",
        "same task and turn are retained",
        "no new research task is created"
      ]
    }
  ]
}
