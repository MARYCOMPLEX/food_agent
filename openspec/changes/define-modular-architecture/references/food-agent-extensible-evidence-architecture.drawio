        </mxCell>
        <mxCell id="p1_result" value="RecommendationComposer&#xa;推荐项 + 证据摘要 + 来源链接 + 评分解释&#xa;结果只引用已持久化 evidence_id" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f0fdfa;strokeColor=#0f766e;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="p1_decision_lane">
