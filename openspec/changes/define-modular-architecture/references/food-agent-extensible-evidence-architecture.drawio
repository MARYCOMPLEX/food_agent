        <mxCell id="p1_media_policy" value="两阶段策略&#xa;阶段 A：正文、评论和 MediaRef&#xa;阶段 B：只下载与当前 ResearchPlan 高相关的媒体&#xa;原始媒体不进入 Prompt、Redis、PostgreSQL JSON 或 SSE" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff7ed;strokeColor=#f97316;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="p1_media_lane">
