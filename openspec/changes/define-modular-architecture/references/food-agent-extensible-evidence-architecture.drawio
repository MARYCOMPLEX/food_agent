        </mxCell>
        <mxCell id="p2_normalize" value="EvidenceNormalizer&#xa;文本清洗、去重、实体与时间标准化&#xa;保持 document/comment 原始边界" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#cffafe;strokeColor=#0891b2;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="p2_metadata_lane">
          <mxGeometry x="1160" y="65" width="330" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p2_text_evidence" value="Text EvidenceItem&#xa;claim_type · normalized_value · confidence&#xa;source_locator = document_id | comment_id&#xa;extractor_version · captured_at" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f0fdfa;strokeColor=#0f766e;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="p2_metadata_lane">
          <mxGeometry x="1555" y="65" width="350" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p2_gate" value="Media Relevance Gate&#xa;根据 ResearchPlan、文本证据质量、媒体类型和预算&#xa;把 selected=false/true 写回 MediaRef" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="p2_metadata_lane">
          <mxGeometry x="1970" y="65" width="460" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p2_a_note" value="例 1：笔记正文图片 → MediaRef(owner_type=document, owner_id=NOTE_ID)&#xa;例 2：评论晒图 → MediaRef(owner_type=comment, owner_id=COMMENT_ID)&#xa;例 3：笔记视频音轨 → 同一个 MediaAsset 派生 ASR 与关键帧证据" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#f0fdfa;strokeColor=#0f766e;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="p2_metadata_lane">
          <mxGeometry x="35" y="225" width="2395" height="80" as="geometry" />
        </mxCell>

        <mxCell id="p2_media_lane" value="阶段 B：仅处理已选择媒体" style="swimlane;startSize=34;horizontal=1;rounded=0;html=1;fillColor=#fff7ed;swimlaneFillColor=#ffffff;strokeColor=#f97316;strokeWidth=2;fontColor=#9a3412;fontSize=14;fontStyle=1;container=1;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="760" width="2480" height="360" as="geometry" />
        </mxCell>
        <mxCell id="p2_job" value="Temporal Media Workflow&#xa;source_id + external_media_id 幂等&#xa;平台级 rate limit / concurrency" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="p2_media_lane">
          <mxGeometry x="35" y="75" width="280" height="105" as="geometry" />
        </mxCell>
        <mxCell id="p2_download" value="Fetch + Validate&#xa;重定向与域名策略、MIME、大小、超时&#xa;流式下载，不在内存聚合大文件" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="p2_media_lane">
          <mxGeometry x="365" y="75" width="300" height="105" as="geometry" />
        </mxCell>
        <mxCell id="p2_hash" value="Hash + Deduplicate&#xa;SHA-256 content hash&#xa;已有资产只增加 provenance link" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="p2_media_lane">
          <mxGeometry x="715" y="75" width="280" height="105" as="geometry" />
        </mxCell>
        <mxCell id="p2_object_store" value="MinIO&#xa;原始对象 + 派生对象&#xa;object_uri 以 hash 分片" style="shape=cylinder3;size=15;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="p2_media_lane">
          <mxGeometry x="1045" y="65" width="250" height="125" as="geometry" />
        </mxCell>
        <mxCell id="p2_asset" value="MediaAsset&#xa;asset_id · sha256 · mime · bytes&#xa;object_uri · width/height/duration&#xa;status · captured_at" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="p2_media_lane">
          <mxGeometry x="1345" y="65" width="300" height="125" as="geometry" />
        </mxCell>
        <mxCell id="p2_processor_registry" value="MediaProcessorRegistry&#xa;ImageOCR · AudioASR&#xa;VideoKeyframes · ffprobe metadata" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="p2_media_lane">
          <mxGeometry x="1695" y="65" width="300" height="125" as="geometry" />
        </mxCell>
        <mxCell id="p2_new_processor" value="New Media Processor&#xa;supports(media_type, mime)&#xa;process(asset) → DerivedArtifact[]" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=3;fontColor=#14532d;fontSize=12;fontStyle=1;" vertex="1" parent="p2_media_lane">
          <mxGeometry x="2050" y="65" width="380" height="125" as="geometry" />
        </mxCell>
        <mxCell id="p2_artifact" value="DerivedArtifact&#xa;ocr_text | transcript | keyframe | metadata&#xa;asset_id + processor_name + processor_version + object_uri?" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#f97316;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="p2_media_lane">
          <mxGeometry x="1345" y="235" width="650" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2_new_extractor" value="New Evidence Extractor&#xa;DerivedArtifact → EvidenceItem[]&#xa;版本化 schema 与置信度" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=3;fontColor=#14532d;fontSize=12;fontStyle=1;" vertex="1" parent="p2_media_lane">
          <mxGeometry x="2050" y="225" width="380" height="90" as="geometry" />
        </mxCell>

        <mxCell id="p2_store_lane" value="证据、来源链与存储" style="swimlane;startSize=34;horizontal=1;rounded=0;html=1;fillColor=#f0fdfa;swimlaneFillColor=#ffffff;strokeColor=#0f766e;strokeWidth=2;fontColor=#155e75;fontSize=14;fontStyle=1;container=1;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="1150" width="2480" height="350" as="geometry" />
        </mxCell>
        <mxCell id="p2_evidence" value="EvidenceItem&#xa;id · claim_type · value · confidence&#xa;source_locator · asset_id? · extractor_version&#xa;可以是正文、评论、OCR、ASR 或视频帧证据" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f0fdfa;strokeColor=#0f766e;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="p2_store_lane">
          <mxGeometry x="35" y="70" width="360" height="125" as="geometry" />
        </mxCell>
        <mxCell id="p2_locator" value="SourceLocator&#xa;source_id · document_id&#xa;comment_id? · media_ref_id? · asset_id?&#xa;canonical_url · captured_at" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0f766e;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="p2_store_lane">
          <mxGeometry x="455" y="70" width="330" height="125" as="geometry" />
        </mxCell>
        <mxCell id="p2_provenance" value="ProvenanceService&#xa;Evidence → Document / Comment / Asset&#xa;保留 parent_comment 与 media owner 关系&#xa;生成用户可点击的来源说明" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0f766e;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="p2_store_lane">
          <mxGeometry x="845" y="70" width="370" height="125" as="geometry" />
        </mxCell>
        <mxCell id="p2_pg" value="PostgreSQL + pgvector&#xa;documents / comments / media_refs / media_assets&#xa;evidence_items / provenance_edges / embeddings&#xa;权威事实与查询索引" style="shape=cylinder3;size=15;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="p2_store_lane">
          <mxGeometry x="1275" y="60" width="390" height="145" as="geometry" />
        </mxCell>
        <mxCell id="p2_redis" value="Redis 7 Hot State&#xa;session / SSE / rate limit / short idempotency&#xa;可重建；Temporal 承载 workflow history" style="shape=cylinder3;size=15;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="p2_store_lane">
          <mxGeometry x="1725" y="60" width="300" height="145" as="geometry" />
        </mxCell>
        <mxCell id="p2_rule" value="禁止项&#xa;1. Connector 不下载和永久保存媒体&#xa;2. Agent 不接收原始二进制或平台私有响应&#xa;3. Redis 不作为证据事实源&#xa;4. 删除平台时，不删除已经规范化并带 provenance 的历史证据" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff7ed;strokeColor=#f97316;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="p2_store_lane">
          <mxGeometry x="2085" y="50" width="345" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p2_query" value="推荐与回答查询只读取 EvidenceItem + Provenance，不回查平台原始响应；需要刷新时创建新的采集任务并产生新版本。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;dashed=1;fontSize=12;" vertex="1" parent="p2_store_lane">
          <mxGeometry x="35" y="250" width="1990" height="60" as="geometry" />
        </mxCell>

