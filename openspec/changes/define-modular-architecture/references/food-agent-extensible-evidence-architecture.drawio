        <mxCell id="p1_redis" value="Redis 7 Hot State&#xa;会话窗口 / SSE Stream / 限速 / 短幂等&#xa;可重建、非权威数据；不承载队列或锁" style="shape=cylinder3;size=15;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="p1_infra_lane">
          <mxGeometry x="35" y="70" width="260" height="135" as="geometry" />
        </mxCell>
        <mxCell id="p1_postgres" value="PostgreSQL + pgvector&#xa;任务、会话、偏好、规范内容&#xa;Evidence、Provenance、资产元数据&#xa;唯一事实源" style="shape=cylinder3;size=15;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="p1_infra_lane">
