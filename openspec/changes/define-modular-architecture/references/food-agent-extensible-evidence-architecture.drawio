  <diagram id="media-provenance" name="02-媒体采集与来源链">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1600" math="0" shadow="0" background="#f8fafc">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="p2_title" value="统一采集模型：笔记、评论与媒体共享同一条来源链" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="60" y="25" width="1600" height="45" as="geometry" />
        </mxCell>
        <mxCell id="p2_subtitle" value="平台 Connector 只负责取数和规范化引用；媒体下载、对象存储和 OCR/ASR/视频分析是独立子域。任何派生证据都能反向定位到具体笔记、评论或媒体资产。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="60" y="70" width="2100" height="45" as="geometry" />
        </mxCell>
        <mxCell id="p2_legend" value="绿色框 = 新扩展点" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=3;fontColor=#14532d;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="2220" y="35" width="300" height="55" as="geometry" />
        </mxCell>

        <mxCell id="p2_source_lane" value="平台适配层" style="swimlane;startSize=34;horizontal=1;rounded=0;html=1;fillColor=#fff7ed;swimlaneFillColor=#ffffff;strokeColor=#f97316;strokeWidth=2;fontColor=#9a3412;fontSize=14;fontStyle=1;container=1;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="135" width="2480" height="215" as="geometry" />
        </mxCell>
        <mxCell id="p2_collect" value="CollectRequest&#xa;query · source_scope · depth&#xa;media_policy = refs_only | selected" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#cffafe;strokeColor=#0891b2;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="p2_source_lane">
          <mxGeometry x="35" y="65" width="270" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2_gateway" value="SourceGateway&#xa;游标、限速、重试、并发配额&#xa;按 source_id 解析 Connector" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="p2_source_lane">
          <mxGeometry x="370" y="65" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2_xhs" value="XHSConnector&#xa;search / document / comments / media refs&#xa;返回 CanonicalSourceBatch" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="p2_source_lane">
          <mxGeometry x="735" y="65" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2_new_platform" value="New Platform Connector&#xa;实现相同 SourceConnector 契约&#xa;平台字段只能存在于 adapter 内部" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=3;fontColor=#14532d;fontSize=12;fontStyle=1;" vertex="1" parent="p2_source_lane">
          <mxGeometry x="1120" y="65" width="330" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2_connector_contract" value="SourceConnector Contract&#xa;search(request)&#xa;fetch_document(ref)&#xa;fetch_comments(document_ref, cursor)&#xa;list_media_refs(owner_ref)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;strokeWidth=2;dashed=1;fontSize=12;fontStyle=1;" vertex="1" parent="p2_source_lane">
          <mxGeometry x="1515" y="50" width="350" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p2_batch" value="CanonicalSourceBatch&#xa;documents[] · comments[] · authors[] · media_refs[]&#xa;不包含原始媒体二进制" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f0fdfa;strokeColor=#0f766e;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="p2_source_lane">
