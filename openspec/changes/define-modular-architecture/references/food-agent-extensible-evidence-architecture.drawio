          <mxGeometry x="745" y="65" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p1_new_processor" value="New Media Processor&#xa;实现 MediaProcessorContract&#xa;例如菜品检测 / 封面质量" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=3;fontColor=#14532d;fontSize=12;fontStyle=1;" vertex="1" parent="p1_media_lane">
          <mxGeometry x="1100" y="65" width="270" height="100" as="geometry" />
