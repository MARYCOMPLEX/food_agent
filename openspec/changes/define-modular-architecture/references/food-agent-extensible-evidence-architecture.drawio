        <mxCell id="p1_fixed_workflow" value="FoodSearchWorkflow v1&#xa;固定高价值流程&#xa;意图 → 采集 → 证据 → POI → 评分 → 结果&#xa;作为一个高层 Agent Tool" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="p1_decision_lane">
