        </mxCell>
        <mxCell id="p1_authenticity" value="AuthenticityScorer&#xa;确定性特征与版本化权重&#xa;广告嫌疑、评论可信度、时间衰减&#xa;输出解释项，不让 LLM 直接改分" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f0fdfa;strokeColor=#0f766e;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="p1_decision_lane">
