        </mxCell>

        <mxCell id="p1_media_lane" value="媒体资产子域：独立队列、延迟下载、可插拔处理器" style="swimlane;startSize=34;horizontal=1;rounded=0;html=1;fillColor=#fff7ed;swimlaneFillColor=#ffffff;strokeColor=#f97316;strokeWidth=2;fontColor=#9a3412;fontSize=14;fontStyle=1;container=1;pointerEvents=0;" vertex="1" parent="1">
