{
  "schemaVersion": "qualification-manifest/v1",
  "milestone": "observability",
  "dataset": {
    "schemaVersion": "evaluation/v1",
    "version": "v1",
    "path": "fixtures/evaluation-dataset-observability-v1.json"
  },
  "evaluator": {
    "version": "deterministic-exact/v1",
    "deterministic": true
  },
  "requiredObservations": [
