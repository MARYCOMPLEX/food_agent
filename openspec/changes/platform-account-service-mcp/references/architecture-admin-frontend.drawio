<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="前台-管理端-上游账号服务">
    <mxGraphModel dx="1800" dy="1180" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1180" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Food Agent 当前架构：前台、管理端与上游账号服务" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=24;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="HTTP/REST/SSE 负责业务操作；MCP 只负责能力发现与受控调用；账号凭据和浏览器状态永远留在上游服务。" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#4b5563;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1050" height="30" as="geometry" />
        </mxCell>

        <mxCell id="zone-consumer" value="前台用户端 · Browser" style="swimlane;startSize=30;html=1;whiteSpace=wrap;fontStyle=1;fillColor=#eff6ff;strokeColor=#60a5fa;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="420" height="420" as="geometry" />
        </mxCell>
        <mxCell id="consumer-app" value="User Web App&#xa;React 19 + TypeScript + Vite&#xa;探索 / 会话 / 餐厅详情 / 收藏&#xa;历史 / 偏好 / 账号扫码登录&#xa;只持有 session_id、account_ref、flow_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#111827;" vertex="1" parent="zone-consumer">
          <mxGeometry x="25" y="80" width="370" height="210" as="geometry" />
        </mxCell>
        <mxCell id="consumer-identity" value="当前身份：X-Device-Id&#xa;正式后台需要 JWT/OIDC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#93c5fd;fontColor=#374151;" vertex="1" parent="zone-consumer">
          <mxGeometry x="25" y="320" width="370" height="50" as="geometry" />
        </mxCell>

        <mxCell id="zone-admin" value="主应用管理端 · Console" style="swimlane;startSize=30;html=1;whiteSpace=wrap;fontStyle=1;fillColor=#fff7ed;strokeColor=#fb923c;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="420" height="480" as="geometry" />
        </mxCell>
        <mxCell id="admin-app" value="Admin Console&#xa;服务健康 / capability 审批&#xa;任务 / Evidence / Query Family&#xa;Domain Pack / 租户 / 审计 / canary / 回滚&#xa;仅看脱敏投影与聚合指标" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#d97706;fontColor=#111827;" vertex="1" parent="zone-admin">
          <mxGeometry x="25" y="80" width="370" height="245" as="geometry" />
        </mxCell>
        <mxCell id="admin-rbac" value="角色：operator / admin / release_manager&#xa;当前代码需补完整 RBAC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fdba74;fontColor=#374151;" vertex="1" parent="zone-admin">
          <mxGeometry x="25" y="355" width="370" height="60" as="geometry" />
        </mxCell>

        <mxCell id="zone-main" value="主应用 · Food Agent" style="swimlane;startSize=30;html=1;whiteSpace=wrap;fontStyle=1;fillColor=#f9fafb;strokeColor=#64748b;" vertex="1" parent="1">
          <mxGeometry x="500" y="110" width="630" height="930" as="geometry" />
        </mxCell>
        <mxCell id="api" value="API &amp; Experience&#xa;FastAPI REST + SSE&#xa;搜索 / 收藏 / 历史 / 用户 / 平台账号&#xa;统一错误 envelope，不直接实例化 provider" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#d97706;" vertex="1" parent="zone-main">
          <mxGeometry x="40" y="80" width="550" height="105" as="geometry" />
        </mxCell>
        <mxCell id="orchestrator" value="Research Orchestrator&#xa;Pydantic AI：意图、计划、工具、结构化输出&#xa;Temporal：Research / Refresh / Media durable workflow&#xa;Temporal 是执行恢复权威" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e7ff;strokeColor=#4f46e5;" vertex="1" parent="zone-main">
          <mxGeometry x="40" y="225" width="550" height="120" as="geometry" />
        </mxCell>
        <mxCell id="evidence" value="Evidence Intelligence&#xa;Canonical Source / Query Family&#xa;Freshness / Bundle / media / quality&#xa;公共证据，不混入用户偏好" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;" vertex="1" parent="zone-main">
          <mxGeometry x="40" y="380" width="260" height="170" as="geometry" />
        </mxCell>
        <mxCell id="registry" value="Account Service Registry&#xa;频道隔离：xhs_pc / creator / dianping&#xa;HTTP：账号、登录、source&#xa;MCP：initialize / tools/list / call&#xa;descriptor 过期即 fail-closed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#7c3aed;" vertex="1" parent="zone-main">
          <mxGeometry x="330" y="380" width="260" height="170" as="geometry" />
        </mxCell>
        <mxCell id="foundation" value="Foundation：PostgreSQL 16（业务事实）&#xa;Redis 7.4（可重建热状态）&#xa;Temporal Service（执行恢复）&#xa;ObjectStore（QR/媒体二进制与 signed ref）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#16a34a;" vertex="1" parent="zone-main">
          <mxGeometry x="40" y="600" width="550" height="220" as="geometry" />
        </mxCell>

        <mxCell id="zone-upstream" value="上游账号微服务 · 独立部署" style="swimlane;startSize=30;html=1;whiteSpace=wrap;fontStyle=1;fillColor=#f5f3ff;strokeColor=#8b5cf6;" vertex="1" parent="1">
          <mxGeometry x="1180" y="110" width="570" height="930" as="geometry" />
        </mxCell>
        <mxCell id="xhs-service" value="xhs-account-service&#xa;channels：xhs_pc / xhs_creator&#xa;HTTP operational + MCP discovery&#xa;XHS provider / Playwright / Node / signer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;" vertex="1" parent="zone-upstream">
          <mxGeometry x="40" y="80" width="490" height="190" as="geometry" />
        </mxCell>
        <mxCell id="dp-service" value="dianping-account-service&#xa;channel：dianping&#xa;独立账号、browser context、session、health&#xa;不与 XHS 共享 Cookie / profile / lease / signer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;" vertex="1" parent="zone-upstream">
          <mxGeometry x="40" y="335" width="490" height="190" as="geometry" />
        </mxCell>
        <mxCell id="provider-admin" value="Provider Service Admin（不属于主应用）&#xa;真实账号 DB / QR worker / browser profiles&#xa;Cookie / storage state / signer state&#xa;风控挑战 / provider 原始响应 / 依赖升级&#xa;主应用只能得到 opaque reference 投影" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f4f6;strokeColor=#6b7280;dashed=1;" vertex="1" parent="zone-upstream">
          <mxGeometry x="40" y="590" width="490" height="220" as="geometry" />
        </mxCell>

        <!-- Browser and admin access -->
        <mxCell id="edge-consumer-api" value="REST / SSE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;endArrow=block;" edge="1" parent="1" source="consumer-app" target="api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-admin-api" value="管理 API" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d97706;endArrow=block;" edge="1" parent="1" source="admin-app" target="api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-api-orch" value="Research request" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d97706;endArrow=block;" edge="1" parent="1" source="api" target="orchestrator">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-orch-evidence" value="Evidence / Domain Pack" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;endArrow=block;" edge="1" parent="1" source="orchestrator" target="evidence">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-orch-registry" value="账号能力" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;endArrow=block;" edge="1" parent="1" source="orchestrator" target="registry">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-orch-foundation" value="事实 / 任务投影" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;endArrow=block;" edge="1" parent="1" source="orchestrator" target="foundation">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-registry-xhs" value="HTTP operational" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;endArrow=block;" edge="1" parent="1" source="registry" target="xhs-service">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-registry-dp" value="HTTP operational" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;endArrow=block;" edge="1" parent="1" source="registry" target="dp-service">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-registry-mcp" value="MCP discovery / call" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;dashed=1;endArrow=block;" edge="1" parent="1" source="registry" target="xhs-service">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-xhs-admin" value="provider-owned state" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;endArrow=block;" edge="1" parent="1" source="xhs-service" target="provider-admin">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-dp-admin" value="provider-owned state" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;endArrow=block;" edge="1" parent="1" source="dp-service" target="provider-admin">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-forbidden" value="禁止：浏览器/主应用直连 provider 或保存凭据" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#dc2626;dashed=1;endArrow=block;" edge="1" parent="1" source="consumer-app" target="provider-admin">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="数据权威：PostgreSQL 业务事实；Temporal 执行恢复；Redis 仅可重建热状态；ObjectStore 保存二进制。" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#4b5563;" vertex="1" parent="1">
          <mxGeometry x="40" y="1090" width="1500" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
